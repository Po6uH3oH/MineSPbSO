{
  "name": "community-smp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "main": "dist/app/main.cjs",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "dev": "electron .",
    "service": "tsx src/service/main.ts",
    "migrate": "tsx src/service/migrate.ts",
    "admin": "tsx src/service/admin.ts",
    "install-game": "tsx scripts/install-game.ts",
    "pack": "tsx scripts/pack.ts",
    "audit-mods": "tsx scripts/audit-mods.ts",
    "dist:win": "pnpm build && electron-builder --win nsis --x64 --publish never"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@xmcl/core": "^2.16.2",
    "@xmcl/installer": "^6.3.6",
    "@xmcl/unzip": "2.2.0",
    "adm-zip": "^0.6.1",
    "argon2": "^0.45.1",
    "electron-updater": "^6.8.11",
    "fastify": "^5.12.7",
    "nbtify": "2.2.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "pngjs": "^7.0.0",
    "smol-toml": "^1.9.1",
    "undici": "7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
